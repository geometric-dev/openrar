#!/usr/bin/make -f
export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DOPENRAR_BUILD_TESTS=ON

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	-strip --strip-debug obj-*/Default.SFX 2>/dev/null || true
	dh_auto_test -- ARGS="--output-on-failure -E '(sandbox_sandboxed_e2e_tests)'"
endif
