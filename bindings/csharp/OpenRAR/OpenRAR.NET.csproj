<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- OpenRARException uses a C# 8 switch expression; netstandard2.0
         defaults to C# 7.3 and refuses to compile it (CS8370). Nothing
         caught this because no CI job builds the C# binding. -->
    <LangVersion>8.0</LangVersion>
    <AssemblyName>OpenRAR.NET</AssemblyName>
    <RootNamespace>OpenRAR</RootNamespace>
    <Version>1.49.0</Version>
    <PackageId>OpenRAR.NET</PackageId>
    <Description>OpenRAR C# SDK — P/Invoke binding over the frozen OpenRAR C ABI (RAR 5.0 read/create/mutate)</Description>
    <Authors>OpenRAR Project</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/geometric-dev/openrar</RepositoryUrl>
    <!-- Native assets: the release workflow places the per-RID built
         openrar shared libraries in runtimes/<rid>/native (plan M4). -->
  </PropertyGroup>
  <ItemGroup>
    <!-- ConformanceTests.cs calls Native.CreateFile_ (internal static);
         without this attribute the test assembly cannot compile. -->
    <InternalsVisibleTo Include="OpenRAR.Tests" />
  </ItemGroup>
</Project>
