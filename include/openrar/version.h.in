#ifndef OPENRAR_VERSION_H
#define OPENRAR_VERSION_H

#define OPENRAR_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define OPENRAR_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define OPENRAR_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define OPENRAR_VERSION_STRING "@PROJECT_VERSION@"
#define OPENRAR_VERSION_HEX ((@PROJECT_VERSION_MAJOR@ << 24) | (@PROJECT_VERSION_MINOR@ << 16) | (@PROJECT_VERSION_PATCH@ << 8))

#endif /* OPENRAR_VERSION_H */
