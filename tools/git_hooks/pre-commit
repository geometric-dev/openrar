#!/bin/sh
# OpenRAR git pre-commit hook
# Validates anchor lint, version synchrony, and clang-format on staged C/C++ files.

set -e
export MSYS_NO_PATHCONV=1

# Resolve repository root
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

# Detect Python interpreter
if command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON="python"
elif command -v py >/dev/null 2>&1; then
    PYTHON="py"
else
    echo "[pre-commit] WARNING: Python not found in PATH; skipping Python-based lints."
    PYTHON=""
fi

# 1. Version consistency check
if [ -n "$PYTHON" ] && [ -f "tools/bump_version.py" ]; then
    if ! "$PYTHON" tools/bump_version.py --check >/dev/null 2>&1; then
        echo "[pre-commit] ERROR: Version consistency check failed across project files!"
        echo "             Run 'python tools/bump_version.py --check' to see details,"
        echo "             or 'python tools/bump_version.py <version>' to synchronize."
        exit 1
    fi
fi

# 2. Anchor lint check
if [ -n "$PYTHON" ] && [ -f "tools/anchor_lint.py" ]; then
    if ! "$PYTHON" tools/anchor_lint.py >/dev/null 2>&1; then
        echo "[pre-commit] ERROR: anchor_lint reported violations (assert count or anchor mismatch)!"
        echo "             Run 'python tools/anchor_lint.py' to inspect,"
        echo "             and 'python tools/genledger.py' to reconcile the verification ledger."
        exit 1
    fi
fi

# 3. Clang-format check on staged C/C++ files (enforces clang-format 18)
STAGED_CPP=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|h|c)$' || true)

if [ -n "$STAGED_CPP" ]; then
    CF=""
    USE_WSL=0
    if command -v clang-format-18 >/dev/null 2>&1; then
        CF="clang-format-18"
    elif command -v clang-format >/dev/null 2>&1; then
        CF="clang-format"
    elif command -v clang-format.exe >/dev/null 2>&1; then
        CF="clang-format.exe"
    elif command -v wsl >/dev/null 2>&1 && wsl command -v clang-format >/dev/null 2>&1; then
        CF="wsl clang-format"
        USE_WSL=1
    fi

    if [ -n "$CF" ]; then
        VER=$($CF --version 2>/dev/null | grep -oE '[0-9]+' | head -n 1 || true)
        if [ "$VER" != "18" ]; then
            # If native clang-format is not v18, check if WSL has v18
            if [ "$USE_WSL" -eq 0 ] && command -v wsl >/dev/null 2>&1 && wsl command -v clang-format >/dev/null 2>&1; then
                WSL_VER=$(wsl clang-format --version 2>/dev/null | grep -oE '[0-9]+' | head -n 1 || true)
                if [ "$WSL_VER" = "18" ]; then
                    CF="wsl clang-format"
                    USE_WSL=1
                    VER="18"
                fi
            fi
        fi

        if [ "$VER" = "18" ]; then
            UNFORMATTED=""
            for file in $STAGED_CPP; do
                if [ -f "$file" ]; then
                    TARGET_PATH="$file"
                    if [ "$USE_WSL" -eq 1 ]; then
                        TARGET_PATH="$(wsl wslpath -u "$REPO_ROOT/$file" 2>/dev/null || echo "$file")"
                    fi
                    if ! $CF --dry-run --Werror "$TARGET_PATH" >/dev/null 2>&1; then
                        UNFORMATTED="$UNFORMATTED\n  - $file"
                    fi
                fi
            done

            if [ -n "$UNFORMATTED" ]; then
                echo "[pre-commit] ERROR: Staged files do not conform to clang-format 18 style:"
                printf "%b\n" "$UNFORMATTED"
                echo "             Format them with: clang-format -i <file>"
                exit 1
            fi
        else
            echo "[pre-commit] Note: clang-format version $VER detected (repository standard is v18); skipping formatting check to avoid style drift."
        fi
    else
        echo "[pre-commit] Note: clang-format not found; skipping formatting check."
    fi
fi

exit 0
