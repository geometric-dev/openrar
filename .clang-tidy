# Naming enforcement for OpenRAR — mirrors ARCHITECTURE.md §3.2 exactly.
# Only the naming check is enabled here; code-quality checks are a separate
# decision (add them deliberately, not implicitly).
# Run: clang-tidy -p build/<preset> <file>   (needs compile_commands.json,
# which the `default`/`windows-msvc` presets export)
Checks: '-*,readability-identifier-naming'
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  # The frozen C ABI surface uses an UNSCOPED enum (`enum BufferArchiveError
  # : int` in src/archive/rar_errors.hpp, re-exported via abi_contract.hpp and
  # the C header include/openrar/openrar_dll.h). Its RAR_* enumerators are part
  # of the published ABI and must not be renamed. `EnumConstantCase` is
  # therefore left UNSET on purpose: clang-tidy 18 does not honour
  # EnumConstantIgnoredRegexp for unscoped enums (verified empirically), so the
  # only way to exempt the ABI enum is to not enforce a case on unscoped enum
  # constants at all. Scoped enums (enum class) stay enforced below, and
  # ARCHITECTURE.md s3.2 requires enum class everywhere else anyway.
  - key: readability-identifier-naming.ScopedEnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ScopedEnumConstantIgnoredRegexp
    value: '^RAR_'
  - key: readability-identifier-naming.TypeAliasCase
    value: lower_case
  - key: readability-identifier-naming.TypeAliasIgnoredRegexp
    # Callback / function-type aliases stay PascalCase: they are types, and
    # ARCHITECTURE.md s3.2 types are PascalCase. The original list was
    # incomplete; RarError and ArchiveEntryOut are the shared-ABI aliases.
    value: '^(RSCoder16|OutputCallback|InputCallback|MatchFn|InputFn|SinkFn|ParallelSinkFn|ParallelProgressCb|ParallelCancelCb|RarError|ArchiveEntryOut)$'
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case
  # Classes put the trailing underscore on data members; POD structs (wire
  # format blocks that mirror on-disk layout) do not.
  - key: readability-identifier-naming.ClassMemberCase
    value: lower_case
  - key: readability-identifier-naming.ClassMemberSuffix
    value: '_'
  # Class-scope constants (static constexpr members) are UPPER_SNAKE like
  # every other scope — no k-prefix (CONTRIBUTING.md "Code style").
  - key: readability-identifier-naming.ClassConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StructMemberCase
    value: lower_case
  - key: readability-identifier-naming.UnionMemberCase
    value: lower_case
  # The frozen ABI enum is handled by leaving EnumConstantCase unset (see the
  # EnumCase block above); no EnumConstantIgnoredRegexp is needed.
  # System-convention macros (e.g. WIN32_LEAN_AND_MEAN before windows.h).
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '^WIN32_'
  # Windows system-struct replica in win32_meta.cpp.
  - key: readability-identifier-naming.StructIgnoredRegexp
    value: '^_REPARSE'
  # Note: function-local `const` deliberately stays lower_snake (unpoliced);
  # scope/class-scope constants are UPPER via GlobalConstantCase +
  # ConstexprVariableCase below.
  - key: readability-identifier-naming.ConstexprVariableCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  # Note: a file-scope const TABLE is a global constant, so UPPER_CASE applies
  # (crc32.cpp CRC_TABLE, compressor50.cpp LENGTH_SLOT_TABLE). clang-tidy 18
  # does not honour GlobalConstantIgnoredRegexp (verified empirically), so the
  # g_ prefix is not exempted here - const tables use UPPER, mutable globals
  # keep the g_ prefix below.
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionPrefix
    value: 'OPENRAR_'
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: 'g_'
  - key: readability-identifier-naming.IgnoreMainLike
    value: '1'
