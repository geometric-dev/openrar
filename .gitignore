# Build output
build/
build-linux/
build_fuzz/
Testing/
bin/
lib/
obj/

# CMake artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile.cmake

# Compiler intermediate & debug files
*.obj
*.o
*.pdb
*.ilk
*.idb
*.log
*.tlog
*.exp
*.lib
*.a
*.so
*.dylib

# IDE and editor files
.vs/
.vscode/
.idea/
*.user
*.suo

# Local test archives and scratch files (keep committed smoke archives)
*.rar
!tests/*.rar
!tests/fixtures/**/*.rar
!tools/testdata/*.rar
!tests/fuzz/seeds/*
!tests/fuzz/seeds/*.rev

# CI smoke outputs
tests/out_*/

# Generated coverage output
tools/coverage-report.json

# WASM build outputs. These land INSIDE the npm package (wasm/js/dist/) so
# the published tarball can actually resolve the './dist/*.js' its glue
# imports; see cmake/wasm.cmake. Never committed - CI rebuilds them.
wasm/dist/
wasm/js/dist/

# Local test runs (fixture trees, extracted files, token logs)
testrun/
tools/testrun/

# Test failure dumps & parity artifacts
*.rev
!tests/fuzz/seeds/*.rev
*.bad

# Scratch, benchmark, and temporary test outputs
*.bin
!tests/fuzz/crashes/parallel_fallback_dup_input.bin
scratch/
bench_out/
debug_ext/
ext_openrar/
ext_rar/
out_*/
alt/
test_match.cpp
test_small.txt

# Python cache
__pycache__/
*.pyc
.agents/
pin-tool-log.txt

# Scratch cross-validation build
build_cv/

# Secondary native build tree (the -DOPENRAR_INMEM_ARCHIVE=ON leg) and the
# scratch directories the test suites create next to the tree (dest_*, test_*).
# They are local build/run residue, never committed.
build_inmem/
dest_*/
test_*/

# Perf harness local artifacts (corpora + archives; results.json IS committed)
tools/perf/data/
tools/perf/out/
# The canonical bench payload is GENERATED by tools/make_bench_payload.py and
# is ~50 MB of derived text/code/random. results.json records per-corpus
# hashes precisely so the corpus itself is not version-controlled.
tools/perf/payload/
# Benchmark bundle output (tools/make_bench_bundle.ps1): contains package-time
# copies of the local WinRAR install (D4) - never committed.
/dist/

# External-review tooling dumps whole-tree concatenations into the repo root.
# Derived, multi-megabyte, and regenerated on every run - never committed.
core_codebase.txt
filtered_codebase.txt
